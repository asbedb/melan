{
	"name": "create-melan",
	"version": "0.2.2",
	"description": "Create a new Melan blog: a Markdown blog for SvelteKit.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/asbedb/melan.git",
		"directory": "packages/create-melan"
	},
	"homepage": "https://github.com/asbedb/melan#readme",
	"bugs": {
		"url": "https://github.com/asbedb/melan/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"blog",
		"template",
		"create"
	],
	"type": "module",
	"bin": {
		"create-melan": "./dist/index.js"
	},
	"files": [
		"dist",
		"template"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc && node scripts/copy-template.ts",
