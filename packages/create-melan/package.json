		"lint": "prettier --check .",
		"format": "prettier --write .",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3"
	}
