{
	"name": "@asbedb/melan",
	"version": "0.1.0",
	"description": "A Markdown blog for SvelteKit: Shiki highlighting, KaTeX, CodePen embeds and shadcn-svelte components, set up from one config file.",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/asbedb/melan.git",
		"directory": "packages/melan"
	},
	"homepage": "https://github.com/asbedb/melan#readme",
	"bugs": {
		"url": "https://github.com/asbedb/melan/issues"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"blog",
		"markdown",
		"mdsvex",
		"shiki",
		"shadcn-svelte"
	],
	"type": "module",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./ui": {
			"types": "./dist/ui.d.ts",
			"svelte": "./dist/ui.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"default": "./dist/hooks.js"
		},
		"./config": {
			"types": "./dist/config/index.d.ts",
			"default": "./dist/config/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./styles.css": "./dist/styles/melan.css",
		"./katex.css": "./dist/styles/katex.css",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "svelte-package --watch",
		"build": "svelte-kit sync && svelte-package && publint",
		"prepare": "svelte-kit sync || echo ''",
		"prepublishOnly": "pnpm build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"svelte": "^5.57.0",
		"tailwindcss": "^4.3.0",
		"vite": "^8.0.0"
	},
	"dependencies": {
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@tailwindcss/typography": "^0.5.20",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"katex": "^0.19.0",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"remark-math": "3.0.1",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^4.5.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
