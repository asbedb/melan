{
	"name": "melan-workspace",
	"private": true,
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/asbedb/melan.git"
	},
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @asbedb/melan build && pnpm --parallel --filter @asbedb/melan --filter melan-template dev",
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"lint": "pnpm -r lint && prettier --check .",
		"format": "pnpm -r format && prettier --write .",
		"changeset": "changeset",
		"version-packages": "changeset version && pnpm install --lockfile-only",
		"release": "pnpm --filter @asbedb/melan --filter create-melan build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"prettier": "^3.9.10"
	},
	"packageManager": "pnpm@12.14.0"
}
